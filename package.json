{
  "name": "milsim-concept-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Side-scroller milsim concept demonstrator: fixed perpendicular camera, head-origin visibility, cover states, recon intel and depth-sway aiming. Three.js renderer + local GraphQL scenario API.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"vite preview\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "tsx scripts/screenshots.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.1.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
